{
  "engines": {
    "node": ">=18.0.0"
  },
  "name": "wanderlust",
  "version": "1.0.0",
  "main": "app.js",
  "scripts": {
    "test": "jest --coverage --detectOpenHandles",
    "test:watch": "jest --watch",
    "test:unit": "jest tests/models tests/utils",
    "test:integration": "jest tests/auth.test.js tests/listings.test.js tests/reviews.test.js",
    "start": "node app.js",
    "dev": "nodemon app.js"
  },
  "keywords": [
    "travel",
    "nodejs",
    "express",
    "mongodb",
    "ejs"
  ],
  "author": "Kaushik Mandal",
  "license": "MIT",
  "description": "Wanderlust - a travel experience sharing platform built with Node.js, Express, MongoDB, and EJS.",
  "dependencies": {
    "@google-cloud/translate": "^10.0.1",
    "@mapbox/mapbox-sdk": "^0.16.2",
    "axios": "^1.19.0",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "ejs-mate": "^4.0.0",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.19.0",
    "express-validator": "^7.3.2",
    "google-translate-api-x": "^10.7.3",
    "helmet": "^8.3.0",
    "i18n": "^0.15.3",
    "joi": "^18.2.5",
    "jspdf": "^4.2.1",
    "method-override": "^3.0.0",
    "mongoose": "^8.24.3",
    "multer": "^2.2.0",
    "multer-storage-cloudinary": "^2.2.1",
    "node-cron": "^4.6.0",
    "openai": "^7.5.0",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "passport-local-mongoose": "^9.1.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "coverageDirectory": "coverage",
    "collectCoverageFrom": [
      "**/*.js",
      "!node_modules/**",
      "!coverage/**",
      "!tests/**",
      "!jest.config.js"
    ],
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true
  }
}
