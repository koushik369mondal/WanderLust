<!DOCTYPE html>
<html lang="en" data-theme="light">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="description"
        content="WanderLust - Discover unique places to stay and handcrafted travel experiences">
    <meta name="keywords" content="travel, accommodation, accessibility, inclusive travel, wanderlust">
    <meta name="author" content="WanderLust Team">
    <meta name="theme-color" content="#ffffff">
    <title>
        <% if (typeof title !=='undefined' ) { %>
            <%= title %> - WanderLust<% } else { %>WanderLust - Handcrafted Travel Experiences<% } %>
    </title>

    <!-- ChaiUI Theme Initializer: Light by default, respects dark user preference -->
    <script>
        (function() {
            try {
                var stored = localStorage.getItem('chaiui-theme') || localStorage.getItem('wanderlust-theme-preference');
                if (stored === 'dark') {
                    document.documentElement.classList.add('dark');
                    document.documentElement.setAttribute('data-theme', 'dark');
                } else {
                    document.documentElement.classList.remove('dark');
                    document.documentElement.setAttribute('data-theme', 'light');
                    if (!stored) {
                        localStorage.setItem('chaiui-theme', 'light');
                        localStorage.setItem('wanderlust-theme-preference', 'light');
                    }
                }
            } catch (e) {
                document.documentElement.classList.remove('dark');
                document.documentElement.setAttribute('data-theme', 'light');
            }
        })();
    </script>

    <!-- Favicon: Canonical WanderLust Brand Logo -->
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
    <link rel="apple-touch-icon" href="/images/logo.svg">

    <!-- Fonts: Manrope, Montserrat, Onest, Geist Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net">
    <link href="https://fonts.googleapis.com/css2?family=Geist+Mono:wght@400..600&family=Manrope:wght@200..800&family=Montserrat:wght@400..800&family=Onest:wght@400..700&display=swap" rel="stylesheet">

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css"
        integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA=="
        crossorigin="anonymous" referrerpolicy="no-referrer" />

    <!-- Style Layers -->
    <link rel="stylesheet" href="/CSS/navbar-theme.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="/CSS/style.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="/CSS/rating.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="/CSS/loading.css?v=<%= Date.now() %>">
    <link rel="stylesheet" href="/CSS/chatbot.css?v=<%= Date.now() %>">

    <!-- ChaiUI Design System Core Layer (Modern, Trendy Aesthetic) -->
    <link rel="stylesheet" href="/CSS/chaiui.css?v=<%= Date.now() %>">

    <!-- Mapbox CSS -->
    <link href='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.css' rel='stylesheet' />

    <!-- Structured Data for SEO -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "WebApplication",
      "name": "WanderLust",
      "description": "Accessible travel platform for finding accommodations and travel experiences",
      "url": "<%= process.env.BASE_URL || 'https://wanderlust.com' %>",
      "applicationCategory": "TravelApplication",
      "operatingSystem": "Web Browser",
      "accessibilityAPI": "ARIA",
      "accessibilityControl": "fullKeyboardControl,fullMouseControl,fullTouchControl",
      "accessibilityFeature": "alternativeText,captions,highContrastDisplay,largePrint,readingOrder,screenReader"
    }
    </script>

    <style>
        /* Base page layout */
        html {
            scroll-behavior: smooth;
        }

        html, body {
            overflow-x: hidden;
            max-width: 100vw;
            position: relative;
        }
    </style>
</head>

<body>
    <div class="chai-page-shell">
        <!-- ChaiUI Signature Background Glow Backdrop -->
        <img src="/images/chaiui-background.svg" class="chai-backdrop" alt="" aria-hidden="true" fetchpriority="high" decoding="async">

        <%- include("../includes/navbar.ejs") %>

        <!-- Skip Links (accessible navigation) -->
        <a class="skip-link sr-only-focusable" href="#main-content">Skip to main content</a>
        <a class="skip-link sr-only-focusable" href="#navigation">Skip to navigation</a>

        <!-- Main Content - Centered max-w-6xl container -->
        <main id="main-content" role="main" class="main-container chai-container">
            <%- include("../includes/flash.ejs") %>
            <%- body %>
        </main>

        <%- include("../includes/footer.ejs") %>
        <%- include("../includes/chatbot.ejs") %>
    </div>

    <!-- JavaScript Libraries -->
                <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
                    integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
                    crossorigin="anonymous" defer></script>

                <!-- PDF Library for Offline Functionality -->
                <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/3.0.3/jspdf.umd.min.js" defer></script>

                <!-- Custom JavaScript -->
                <script src="/JS/accessibility.js?v=<%= Date.now() %>" defer></script>
                <script src="/JS/lazy-loading.js?v=<%= Date.now() %>" defer></script>
                <script src="/JS/script.js?v=<%= Date.now() %>" defer></script>
                <script src="/JS/loading.js?v=<%= Date.now() %>" defer></script>
                <script src="/JS/phraseAssistant.js?v=<%= Date.now() %>" defer></script>
                <script src="/JS/offlineManager.js?v=<%= Date.now() %>" defer></script>
                <script src='https://api.mapbox.com/mapbox-gl-js/v3.0.1/mapbox-gl.js' defer></script>


                        <!-- Performance and Accessibility Monitoring -->
                        <script>
                            // Performance monitoring
                            window.addEventListener('load', function () {
                                setTimeout(function () {
                                    const perfData = performance.getEntriesByType('navigation')[0];
                                    if (perfData) {
                                        console.log('Page load time:', perfData.loadEventEnd - perfData.loadEventStart + 'ms');
                                    }
                                }, 0);
                            });

                            // Accessibility error reporting
                            window.addEventListener('error', function (e) {
                                if (e.error && e.error.message && e.error.message.includes('accessibility')) {
                                    console.warn('Accessibility error detected:', e.error.message);
                                }
                            });
                        </script>
</body>

</html>