<% layout("/layouts/boilerplate") %>

<style>
  /* ===================================================================
     About Page - ChaiUI Styling
     =================================================================== */

  .about-hero {
    padding: 4rem 0 3rem;
    position: relative;
    text-align: center;
  }

  .about-hero h1 {
    font-family: var(--font-sans) !important;
    font-size: clamp(2.25rem, 5vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin-bottom: 1rem;
  }

  .about-hero p.lead {
    font-size: clamp(1rem, 1.8vw, 1.25rem);
    color: var(--muted-foreground);
    max-width: 48rem;
    margin: 0 auto 2rem;
    line-height: 1.6;
  }

  /* Stats Section */
  .stats-section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 3.5rem;
  }

  .stat-card {
    text-align: center;
    padding: 1.25rem;
  }

  .stat-number {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--foreground);
    display: block;
    line-height: 1.1;
  }

  .stat-label {
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted-foreground);
    margin-top: 0.35rem;
    display: block;
  }

  /* Section Title */
  .about-section-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    text-align: center;
    margin-bottom: 2.5rem;
  }

  /* Feature Cards */
  .about-card {
    background: rgba(18, 18, 18, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--card-edge);
    border-radius: 0.75rem;
    padding: 1.75rem;
    height: 100%;
    transition: border-color 200ms ease;
  }

  .about-card:hover {
    border-color: var(--card-edge-hover);
  }

  :root:not(.dark) .about-card,
  html:not(.dark) .about-card {
    background: #ffffff;
    border-color: rgba(120, 53, 15, 0.15);
  }

  .feature-icon {
    font-size: 2rem;
    color: var(--brand);
    margin-bottom: 1rem;
    display: inline-block;
  }

  .about-card h4 {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--foreground);
    margin-bottom: 0.5rem;
  }

  .about-card p {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  /* Mission Section */
  .mission-container {
    background: rgba(18, 18, 18, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--card-edge);
    border-radius: 1rem;
    padding: clamp(2rem, 4vw, 3.5rem);
    margin: 3.5rem 0;
  }

  :root:not(.dark) .mission-container,
  html:not(.dark) .mission-container {
    background: #ffffff;
    border-color: rgba(120, 53, 15, 0.15);
  }

  .mission-title {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3vw, 2.25rem);
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 1.25rem;
  }

  .mission-lead {
    font-size: 1.125rem;
    color: var(--foreground);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  .mission-body {
    color: var(--muted-foreground);
    font-size: 1rem;
    line-height: 1.7;
  }

  .mission-item {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.65rem;
    color: var(--foreground);
    font-weight: 500;
    font-size: 0.95rem;
  }

  .mission-emoji-large {
    font-size: clamp(6rem, 12vw, 9rem);
    line-height: 1;
    display: inline-block;
    user-select: none;
  }

  /* Testimonials */
  .testimonial-card {
    background: rgba(18, 18, 18, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--card-edge);
    border-radius: 0.75rem;
    padding: 1.75rem;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: border-color 200ms ease;
  }

  .testimonial-card:hover {
    border-color: var(--card-edge-hover);
  }

  :root:not(.dark) .testimonial-card,
  html:not(.dark) .testimonial-card {
    background: #ffffff;
    border-color: rgba(120, 53, 15, 0.15);
  }

  .testimonial-avatar {
    width: 48px;
    height: 48px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--card-edge);
    color: var(--foreground);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.125rem;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1.25rem;
  }

  :root:not(.dark) .testimonial-avatar,
  html:not(.dark) .testimonial-avatar {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
  }

  .testimonial-quote {
    color: var(--foreground);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
    flex: 1;
  }

  .testimonial-author {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--foreground);
  }

  .testimonial-location {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
    display: flex;
    align-items: center;
    gap: 0.35rem;
    margin-top: 0.2rem;
  }

  /* Team */
  .team-card {
    background: rgba(18, 18, 18, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--card-edge);
    border-radius: 0.75rem;
    padding: 2rem 1.75rem;
    text-align: center;
    height: 100%;
    transition: border-color 200ms ease;
  }

  .team-card:hover {
    border-color: var(--card-edge-hover);
  }

  :root:not(.dark) .team-card,
  html:not(.dark) .team-card {
    background: #ffffff;
    border-color: rgba(120, 53, 15, 0.15);
  }

  .team-avatar {
    width: 64px;
    height: 64px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--card-edge);
    color: var(--foreground);
    font-size: 1.75rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }

  :root:not(.dark) .team-avatar,
  html:not(.dark) .team-avatar {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
  }

  .team-name {
    font-family: var(--font-sans);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 0.25rem;
  }

  .team-role {
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--brand);
    margin-bottom: 0.75rem;
  }

  .team-bio {
    font-size: 0.875rem;
    color: var(--muted-foreground);
    line-height: 1.6;
    margin: 0;
  }

  /* CTA Section */
  .about-cta {
    padding: 4rem 0 2rem;
    text-align: center;
  }

  .about-cta h2 {
    font-family: var(--font-sans);
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 1rem;
  }

  .about-cta p {
    color: var(--muted-foreground);
    font-size: 1.125rem;
    max-width: 36rem;
    margin: 0 auto 2rem;
  }
</style>

<div class="chai-container py-3">
  <!-- Hero Section -->
  <section class="about-hero">
    <div class="chai-animated-badge mb-3">
      <span class="chai-animated-badge-text">
        <i class="fa-solid fa-compass me-1" style="color: var(--brand);"></i> WanderLust Story
      </span>
    </div>
    <h1>Welcome to WanderLust</h1>
    <p class="lead">
      Your travel companion for discovering and sharing <span class="highlight">unforgettable adventures</span> across handpicked destinations around the globe.
    </p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a href="/listings" class="btn-solid-asym">
        <i class="fa-solid fa-compass me-2"></i>Explore now
      </a>
      <a href="/signup" class="btn-outline-asym">
        <i class="fa-solid fa-user-plus me-2"></i>Join community
      </a>
    </div>
  </section>

  <!-- Stats Section -->
  <section class="stats-section">
    <div class="row g-4">
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <span class="stat-number">10K+</span>
          <span class="stat-label">Happy travelers</span>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <span class="stat-number">5K+</span>
          <span class="stat-label">Destinations</span>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <span class="stat-number">25K+</span>
          <span class="stat-label">Verified reviews</span>
        </div>
      </div>
      <div class="col-6 col-md-3">
        <div class="stat-card">
          <span class="stat-number">50+</span>
          <span class="stat-label">Countries reached</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section class="py-4">
    <h2 class="about-section-title">What makes WanderLust special</h2>
    <div class="row g-4">
      <div class="col-md-6 col-lg-3">
        <div class="about-card">
          <div class="feature-icon">
            <i class="fa-solid fa-map-marked-alt"></i>
          </div>
          <h4>Discover places</h4>
          <p>Explore thousands of unique destinations shared by fellow travelers.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="about-card">
          <div class="feature-icon">
            <i class="fa-solid fa-camera"></i>
          </div>
          <h4>Share adventures</h4>
          <p>Create beautiful listings and help others discover hidden gems.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="about-card">
          <div class="feature-icon">
            <i class="fa-solid fa-star"></i>
          </div>
          <h4>Real reviews</h4>
          <p>Get authentic insights from travelers who have been there firsthand.</p>
        </div>
      </div>
      <div class="col-md-6 col-lg-3">
        <div class="about-card">
          <div class="feature-icon">
            <i class="fa-solid fa-route"></i>
          </div>
          <h4>Plan journey</h4>
          <p>Use interactive tools and detailed info to plan your perfect trip.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section>
    <div class="mission-container">
      <div class="row align-items-center g-4">
        <div class="col-lg-7">
          <div class="chai-animated-badge mb-3">
            <span class="chai-animated-badge-text">Core Purpose</span>
          </div>
          <h2 class="mission-title">Our mission</h2>
          <p class="mission-lead">
            To create a world where every traveler feels at home, anywhere they go, through <span class="highlight">authentic and transformative</span> experiences.
          </p>
          <p class="mission-body mb-4">
            WanderLust is not just about finding places to stay. It is about discovering journeys that inspire you, connecting with hosts who welcome you, and creating memories that last a lifetime.
          </p>
          <div>
            <div class="mission-item">
              <i class="fa-solid fa-heart me-1" style="color: var(--brand);"></i>
              <span>Authentic community connections</span>
            </div>
            <div class="mission-item">
              <i class="fa-solid fa-sparkles me-1" style="color: var(--brand);"></i>
              <span>Curated local recommendations</span>
            </div>
            <div class="mission-item">
              <i class="fa-solid fa-house me-1" style="color: var(--brand);"></i>
              <span>Feel comfortable anywhere on earth</span>
            </div>
          </div>
        </div>
        <div class="col-lg-5 text-center">
          <div class="mission-emoji-large">🌍</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-4">
    <h2 class="about-section-title">What our travelers say</h2>
    <div class="row g-4">
      <div class="col-md-6 col-lg-4">
        <div class="testimonial-card">
          <div>
            <div class="testimonial-avatar">M</div>
            <p class="testimonial-quote">
              "Hey! I am Mary and I just came back from the most amazing trip to Bali. WanderLust helped me find a hidden waterfall not in any guidebook. The recommendations were spot on."
            </p>
          </div>
          <div>
            <div class="testimonial-author">Mary Johnson</div>
            <div class="testimonial-location">
              <i class="fa-solid fa-location-dot"></i> New York, USA
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="testimonial-card">
          <div>
            <div class="testimonial-avatar">A</div>
            <p class="testimonial-quote">
              "As a solo female traveler, safety is my priority. The detailed reviews and photos on WanderLust gave me confidence to explore Tokyo on my own. Met wonderful people along the way."
            </p>
          </div>
          <div>
            <div class="testimonial-author">Alex Chen</div>
            <div class="testimonial-location">
              <i class="fa-solid fa-location-dot"></i> Toronto, Canada
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="testimonial-card">
          <div>
            <div class="testimonial-avatar">R</div>
            <p class="testimonial-quote">
              "I have been using WanderLust for two years now. From the Swiss Alps to Moroccan deserts, every recommendation has been reliable and authentic."
            </p>
          </div>
          <div>
            <div class="testimonial-author">Raj Patel</div>
            <div class="testimonial-location">
              <i class="fa-solid fa-location-dot"></i> Mumbai, India
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="testimonial-card">
          <div>
            <div class="testimonial-avatar">S</div>
            <p class="testimonial-quote">
              "Planning our honeymoon was stressful until we found WanderLust. The couples who shared romantic getaway spots made our Santorini trip truly magical."
            </p>
          </div>
          <div>
            <div class="testimonial-author">Sarah & Mike</div>
            <div class="testimonial-location">
              <i class="fa-solid fa-location-dot"></i> London, UK
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="testimonial-card">
          <div>
            <div class="testimonial-avatar">L</div>
            <p class="testimonial-quote">
              "As a budget backpacker, I appreciate that WanderLust shows real costs and practical tips. Found incredible hostels in Prague and Budapest."
            </p>
          </div>
          <div>
            <div class="testimonial-author">Lucas Schmidt</div>
            <div class="testimonial-location">
              <i class="fa-solid fa-location-dot"></i> Berlin, Germany
            </div>
          </div>
        </div>
      </div>

      <div class="col-md-6 col-lg-4">
        <div class="testimonial-card">
          <div>
            <div class="testimonial-avatar">P</div>
            <p class="testimonial-quote">
              "Traveling with kids is challenging, but WanderLust family-friendly filters and parent reviews made our Costa Rica trip smooth and fun for all of us."
            </p>
          </div>
          <div>
            <div class="testimonial-author">Priya Sharma</div>
            <div class="testimonial-location">
              <i class="fa-solid fa-location-dot"></i> Sydney, Australia
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-4">
    <h2 class="about-section-title">Meet our team</h2>
    <div class="row g-4">
      <div class="col-md-4">
        <div class="team-card">
          <div class="team-avatar">K</div>
          <h4 class="team-name">Kaushik Mandal</h4>
          <p class="team-role">Founder & Lead Developer</p>
          <p class="team-bio">Passionate about creating technology that connects travelers worldwide with unforgettable destinations.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="team-card">
          <div class="team-avatar">🤖</div>
          <h4 class="team-name">AI Assistant</h4>
          <p class="team-role">Development Partner</p>
          <p class="team-bio">Refining experiences and ensuring every line of code powers delightful travel discoveries.</p>
        </div>
      </div>
      <div class="col-md-4">
        <div class="team-card">
          <div class="team-avatar">🌟</div>
          <h4 class="team-name">You</h4>
          <p class="team-role">Community Member</p>
          <p class="team-bio">Every traveler, host, and explorer who joins WanderLust helps make our journey richer.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="about-cta">
    <h2>Ready to start your adventure?</h2>
    <p>Join thousands of travelers who use WanderLust to plan authentic journeys worldwide.</p>
    <div class="d-flex justify-content-center gap-3 flex-wrap">
      <a href="/listings" class="btn-solid-asym">
        <i class="fa-solid fa-compass me-2"></i>Explore destinations
      </a>
      <a href="/signup" class="btn-outline-asym">
        <i class="fa-solid fa-user-plus me-2"></i>Join community
      </a>
    </div>
  </section>
</div>