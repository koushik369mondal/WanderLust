<% layout('/layouts/boilerplate') %>

<%
// Helper functions for template
function getCategoryIcon(category) {
    const icons = {
        explorer: 'compass',
        reviewer: 'star',
        host: 'home',
        social: 'users',
        milestone: 'medal'
    };
    return icons[category] || 'trophy';
}

function getCategoryDescription(category) {
    const descriptions = {
        explorer: 'Discover new places and expand your travel horizons',
        reviewer: 'Share your experiences and help others make informed decisions',
        host: 'Create amazing listings and welcome travelers from around the world',
        social: 'Connect with the travel community and build your network',
        milestone: 'Celebrate your journey and reach important travel milestones'
    };
    return descriptions[category] || 'Complete challenges and earn recognition';
}
%>

<style>
    .achievements-container {
        max-width: 1200px;
        margin: 2rem auto 4rem;
        padding: 0 1rem;
        color: var(--foreground);
        font-family: var(--font-sans);
    }

    .achievements-header {
        text-align: center;
        margin-bottom: 2.5rem;
    }

    .achievements-header h1 {
        font-family: var(--font-sans);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
        color: var(--foreground);
    }

    .achievements-header p {
        font-size: 1.05rem;
        color: var(--muted-foreground);
        margin-bottom: 0;
    }

    .stats-overview {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 1.25rem;
        margin-bottom: 2.5rem;
    }

    .stat-card {
        background: var(--card-fill);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--card-edge);
        border-radius: 0.75rem;
        padding: 1.5rem;
        text-align: center;
        color: var(--foreground);
        box-shadow: none;
        transition: border-color 0.2s ease, transform 0.2s ease;
    }

    .stat-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .stat-number {
        font-size: 2.25rem;
        font-weight: 700;
        margin-bottom: 0.35rem;
        display: block;
        color: var(--brand);
    }

    .stat-label {
        font-size: 0.875rem;
        color: var(--muted-foreground);
        font-weight: 500;
    }

    .category-section {
        margin-bottom: 2.5rem;
    }

    .category-header {
        background: var(--card-fill);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--card-edge);
        border-radius: 0.75rem;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
        color: var(--foreground);
        box-shadow: none;
    }

    .category-title {
        font-family: var(--font-sans);
        font-size: 1.35rem;
        font-weight: 600;
        letter-spacing: -0.02em;
        margin-bottom: 0.25rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--foreground);
    }

    .category-title i {
        color: var(--brand);
        font-size: 1.15rem;
    }

    .category-description {
        color: var(--muted-foreground);
        font-size: 0.875rem;
        margin: 0;
    }

    .achievements-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1.25rem;
    }

    .achievement-card {
        background: var(--card-fill);
        border: 1px solid var(--card-edge);
        border-radius: 0.75rem;
        overflow: hidden;
        box-shadow: none;
        transition: border-color 0.2s ease, transform 0.2s ease;
        position: relative;
    }

    .achievement-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.2);
    }

    .achievement-header {
        background: rgba(255, 255, 255, 0.04);
        border-bottom: 1px solid var(--card-edge);
        padding: 1.25rem;
        text-align: center;
        color: var(--foreground);
        position: relative;
    }

    .achievement-icon {
        font-size: 2.5rem;
        margin-bottom: 0.5rem;
        color: var(--brand);
    }

    .achievement-card.locked .achievement-icon {
        opacity: 0.4;
        filter: grayscale(1);
    }

    .achievement-name {
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
        color: var(--foreground);
    }

    .achievement-description {
        font-size: 0.8125rem;
        color: var(--muted-foreground);
        margin-bottom: 0;
    }

    .achievement-body {
        padding: 1.25rem;
    }

    .progress-section {
        margin-bottom: 1rem;
    }

    .progress-label {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.35rem;
        font-size: 0.8125rem;
        color: var(--muted-foreground);
    }

    .progress {
        height: 6px;
        border-radius: 9999px;
        background-color: rgba(255, 255, 255, 0.08);
        overflow: hidden;
    }

    .progress-bar {
        background: var(--brand);
        transition: width 0.3s ease;
    }

    .achievement-status {
        text-align: center;
        padding: 0.75rem;
        background: rgba(255, 255, 255, 0.02);
        border-top: 1px solid var(--card-edge);
        font-size: 0.8125rem;
    }

    .status-earned {
        color: var(--foreground);
        font-weight: 600;
    }

    .status-locked {
        color: var(--muted-foreground);
        font-weight: 500;
    }

    .earned-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background: var(--brand);
        color: white;
        border-radius: 50%;
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.75rem;
    }

    .empty-category {
        text-align: center;
        padding: 2.5rem;
        color: var(--muted-foreground);
    }

    @media (max-width: 768px) {
        .achievements-grid {
            grid-template-columns: 1fr;
        }

        .stats-overview {
            grid-template-columns: repeat(2, 1fr);
        }
    }
</style>

<div class="achievements-container">
    <!-- Header -->
    <div class="achievements-header">
        <h1><i class="fa-solid fa-trophy me-3"></i>My Achievements</h1>
        <p>Track your progress and unlock badges as you explore the world of Wanderlust</p>
    </div>

    <!-- Stats Overview -->
    <div class="stats-overview">
        <div class="stat-card">
            <span class="stat-number"><%= user.badges.length %></span>
            <span class="stat-label">Badges Earned</span>
        </div>
        <div class="stat-card">
            <span class="stat-number"><%= Object.keys(badgesByCategory).length %></span>
            <span class="stat-label">Categories</span>
        </div>
        <div class="stat-card">
            <span class="stat-number"><%= user.travelStats.totalListings %></span>
            <span class="stat-label">Listings Created</span>
        </div>
        <div class="stat-card">
            <span class="stat-number"><%= user.travelStats.totalReviews %></span>
            <span class="stat-label">Reviews Written</span>
        </div>
    </div>

    <!-- Achievement Categories -->
    <% Object.keys(badgesByCategory).forEach(category => { %>
        <div class="category-section">
            <div class="category-header">
                <h2 class="category-title">
                    <i class="fa-solid fa-<%= getCategoryIcon(category) %> me-2"></i>
                    <%= category.charAt(0).toUpperCase() + category.slice(1) %> Achievements
                </h2>
                <p class="category-description"><%= getCategoryDescription(category) %></p>
            </div>

            <div class="achievements-grid">
                <% badgesByCategory[category].forEach(badge => { %>
                    <div class="achievement-card <%= badge.earned ? 'earned' : 'locked' %> category-<%= category %>">
                        <% if (badge.earned) { %>
                            <div class="earned-badge">
                                <i class="fa-solid fa-check"></i>
                            </div>
                        <% } %>

                        <div class="achievement-header">
                            <div class="achievement-icon">
                                <i class="<%= badge.icon %>"></i>
                            </div>
                            <h3 class="achievement-name"><%= badge.name %></h3>
                            <p class="achievement-description"><%= badge.description %></p>
                        </div>

                        <div class="achievement-body">
                            <% if (!badge.earned) { %>
                                <div class="progress-section">
                                    <div class="progress-label">
                                        <span>Progress</span>
                                        <span><%= badge.progress %>%</span>
                                    </div>
                                    <div class="progress">
                                        <div class="progress-bar" style="width: <%= badge.progress %>%"></div>
                                    </div>
                                    <div class="current-value">
                                        Current: <%= badge.currentValue %> / <%= badge.criteria.threshold %>
                                    </div>
                                </div>
                            <% } %>

                            <div class="achievement-status">
                                <% if (badge.earned) { %>
                                    <div class="status-earned">
                                        <i class="fa-solid fa-trophy me-2"></i>Achievement Unlocked!
                                    </div>
                                <% } else { %>
                                    <div class="status-locked">
                                        <i class="fa-solid fa-lock me-2"></i>Keep going to unlock this badge
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <% if (!badge.earned) { %>
                            <div class="locked-overlay">
                                <i class="fa-solid fa-lock"></i>
                            </div>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </div>
    <% }); %>

    <% if (Object.keys(badgesByCategory).length === 0) { %>
        <div class="empty-category">
            <i class="fa-solid fa-trophy"></i>
            <h3>No Achievements Available</h3>
            <p>Check back later for new achievements to unlock!</p>
        </div>
    <% } %>
</div>
