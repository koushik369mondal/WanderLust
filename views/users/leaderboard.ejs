<% layout('/layouts/boilerplate') %>

<style>
    .leaderboard-container {
        max-width: 1000px;
        margin: 2rem auto 4rem;
        padding: 0 1rem;
        background: transparent !important;
        box-shadow: none !important;
        border: none !important;
        color: var(--foreground) !important;
        font-family: var(--font-sans);
    }

    .leaderboard-header {
        text-align: center;
        margin-bottom: 2.5rem;
        padding: 1.5rem 0;
    }

    .leaderboard-header h1 {
        font-family: var(--font-sans);
        font-size: clamp(2rem, 4vw, 2.75rem);
        font-weight: 700;
        letter-spacing: -0.02em;
        margin-bottom: 0.5rem;
        color: var(--foreground);
        text-shadow: none;
    }

    .leaderboard-header p {
        font-size: 1.05rem;
        color: var(--muted-foreground);
        margin-bottom: 0;
        text-shadow: none;
    }

    .current-user-rank {
        background: var(--card-fill);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--card-edge);
        border-radius: 1rem;
        padding: 2rem;
        margin-bottom: 2.5rem;
        color: var(--foreground);
        text-align: center;
        box-shadow: none;
        text-shadow: none;
    }

    .current-user-rank h2 {
        font-size: 1.35rem;
        font-weight: 600;
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        color: var(--foreground);
    }

    .rank-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--brand);
        margin-bottom: 0.5rem;
        text-shadow: none;
    }

    .rank-stats {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 1rem;
        margin-top: 1.25rem;
    }

    .rank-stat {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--card-edge);
        border-radius: 0.5rem;
        padding: 0.85rem;
    }

    .rank-stat-label {
        font-size: 0.8125rem;
        color: var(--muted-foreground);
        margin-bottom: 0.25rem;
    }

    .rank-stat-value {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--foreground);
    }

    .leaderboard-table {
        border-radius: 1rem;
        overflow: hidden;
        box-shadow: none;
        margin-bottom: 2.5rem;
        background: var(--card-fill);
        border: 1px solid var(--card-edge);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
    }

    .leaderboard-header-row {
        background: rgba(255, 255, 255, 0.04);
        color: var(--muted-foreground);
        padding: 1rem 1.25rem;
        display: grid;
        grid-template-columns: 70px 1fr 110px 110px 110px;
        gap: 1rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        font-size: 0.75rem;
        border-bottom: 1px solid var(--card-edge);
    }

    .leaderboard-row {
        padding: 1rem 1.25rem;
        display: grid;
        grid-template-columns: 70px 1fr 110px 110px 110px;
        gap: 1rem;
        align-items: center;
        border-bottom: 1px solid var(--card-edge);
        transition: background-color 0.2s ease;
        color: var(--foreground);
    }

    .leaderboard-row:last-child {
        border-bottom: none;
    }

    .leaderboard-row:hover {
        background-color: rgba(255, 255, 255, 0.03);
    }

    .leaderboard-row.current-user {
        background: rgba(255, 125, 12, 0.06);
        border-left: 3px solid var(--brand);
    }

    .rank-badge {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--foreground);
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid var(--card-edge);
    }

    .rank-1 {
        border-color: #f59e0b;
        color: #f59e0b;
        background: rgba(245, 158, 11, 0.1);
    }

    .rank-2 {
        border-color: #94a3b8;
        color: #94a3b8;
        background: rgba(148, 163, 184, 0.1);
    }

    .rank-3 {
        border-color: #b45309;
        color: #b45309;
        background: rgba(180, 83, 9, 0.1);
    }

    .user-info {
        display: flex;
        align-items: center;
        gap: 0.85rem;
    }

    .user-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        object-fit: cover;
        border: 1px solid var(--card-edge);
    }

    .user-details h3 {
        margin: 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--foreground);
    }

    .user-details p {
        margin: 0.15rem 0 0 0;
        font-size: 0.8125rem;
        color: var(--muted-foreground);
    }

    .points-display {
        text-align: center;
        font-weight: 700;
        font-size: 1rem;
        color: var(--foreground);
    }

    .badges-count {
        text-align: center;
        font-weight: 600;
        font-size: 0.95rem;
        color: var(--brand);
    }

    .stats-display {
        text-align: center;
        font-size: 0.85rem;
        color: var(--muted-foreground);
    }

    .leaderboard-info {
        background: var(--card-fill);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--card-edge);
        border-radius: 1rem;
        padding: 2rem;
        color: var(--foreground);
        box-shadow: none;
    }

    .leaderboard-info h3 {
        font-size: 1.35rem;
        font-weight: 600;
        margin-bottom: 1rem;
        text-align: center;
        color: var(--foreground);
    }

    .scoring-info {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
        margin-top: 1.25rem;
    }

    .scoring-item {
        background: rgba(255, 255, 255, 0.03);
        border: 1px solid var(--card-edge);
        border-radius: 0.5rem;
        padding: 1rem;
        text-align: center;
    }

    .scoring-item h4 {
        margin: 0 0 0.35rem 0;
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--foreground);
    }

    .scoring-item p {
        margin: 0;
        font-size: 0.8125rem;
        color: var(--muted-foreground);
    }

    /* Responsive Design */
    @media (max-width: 768px) {
        .leaderboard-header-row,
        .leaderboard-row {
            grid-template-columns: 50px 1fr 70px;
            gap: 0.5rem;
            padding: 0.85rem;
        }

        .badges-count, .stats-display {
            display: none;
        }

        .leaderboard-header-row div:nth-child(4),
        .leaderboard-header-row div:nth-child(5) {
            display: none;
        }
    }
</style>

<div class="leaderboard-container">
    <!-- Header -->
    <div class="leaderboard-header">
        <h1><i class="fa-solid fa-trophy me-3"></i>Travel Leaderboard</h1>
        <p>Compete with fellow travelers and climb the ranks!</p>
    </div>

    <!-- Current User Rank -->
    <% if (currentUserRank) { %>
        <div class="current-user-rank">
            <h2><i class="fa-solid fa-user me-2"></i>Your Current Rank</h2>
            <div class="rank-number">#<%= currentUserRank.rank %></div>
            <div class="rank-stats">
                <div class="rank-stat">
                    <div class="rank-stat-label">Total Points</div>
                    <div class="rank-stat-value"><%= currentUserRank.totalPoints %></div>
                </div>
                <div class="rank-stat">
                    <div class="rank-stat-label">Badges Earned</div>
                    <div class="rank-stat-value"><%= currentUserRank.badgesCount %></div>
                </div>
                <div class="rank-stat">
                    <div class="rank-stat-label">Listings</div>
                    <div class="rank-stat-value"><%= currentUserRank.travelStats.totalListings %></div>
                </div>
                <div class="rank-stat">
                    <div class="rank-stat-label">Reviews</div>
                    <div class="rank-stat-value"><%= currentUserRank.travelStats.totalReviews %></div>
                </div>
            </div>
        </div>
    <% } %>

    <!-- Leaderboard Table -->
    <% if (leaderboard && leaderboard.length > 0) { %>
        <div class="leaderboard-table">
            <div class="leaderboard-header-row">
                <div>Rank</div>
                <div>Traveler</div>
                <div>Points</div>
                <div>Badges</div>
                <div>Activity</div>
            </div>

            <% leaderboard.forEach(user => { %>
                <div class="leaderboard-row <%= user.rank <= 3 ? 'top-3' : '' %> <%= user._id.toString() === (typeof req !== 'undefined' && req.user ? req.user._id.toString() : '') ? 'current-user' : '' %>">
                    <div class="rank-badge rank-<%= user.rank <= 3 ? user.rank : 'other' %>">
                        <%= user.rank %>
                    </div>

                    <div class="user-info">
                        <img src="<%= user.avatar %>" alt="<%= user.username %>" class="user-avatar">
                        <div class="user-details">
                            <h3><%= user.username %></h3>
                            <p>Travel Enthusiast</p>
                        </div>
                    </div>

                    <div class="points-display">
                        <%= user.totalPoints %>
                    </div>

                    <div class="badges-count">
                        <i class="fa-solid fa-medal me-1"></i>
                        <%= user.badgesCount %>
                    </div>

                    <div class="stats-display">
                        <span><%= user.travelStats.totalListings %> listings</span>
                        <span><%= user.travelStats.totalReviews %> reviews</span>
                    </div>
                </div>
            <% }); %>
        </div>
    <% } else { %>
        <div class="empty-leaderboard">
            <i class="fa-solid fa-trophy"></i>
            <h3>No Rankings Available</h3>
            <p>Start exploring and earning points to appear on the leaderboard!</p>
        </div>
    <% } %>

    <!-- Scoring Information -->
    <div class="leaderboard-info">
        <h3><i class="fa-solid fa-info-circle me-2"></i>How Points Are Calculated</h3>
        <div class="scoring-info">
            <div class="scoring-item">
                <h4><i class="fa-solid fa-medal me-2"></i>Badges</h4>
                <p>Earn points for unlocking achievements and badges</p>
            </div>
            <div class="scoring-item">
                <h4><i class="fa-solid fa-home me-2"></i>Listings</h4>
                <p>2 points per listing you create</p>
            </div>
            <div class="scoring-item">
                <h4><i class="fa-solid fa-star me-2"></i>Reviews</h4>
                <p>1 point per review you write</p>
            </div>
            <div class="scoring-item">
                <h4><i class="fa-solid fa-map-marker-alt me-2"></i>Destinations</h4>
                <p>3 points per favorite destination</p>
            </div>
        </div>
    </div>
</div>
