<% layout('/layouts/boilerplate') %>

    <div class="row mt-4 mb-5">
        <div class="col-12 col-sm-10 offset-sm-1 col-md-8 offset-md-2 col-lg-6 offset-lg-3">
            <div class="auth-container card-chai p-4 p-sm-5">
                <div class="text-center mb-4">
                    <h1 class="auth-title h3 mb-2" style="font-family: var(--font-sans); font-weight: 600; letter-spacing: -0.02em;">Log in</h1>
                    <p class="text-muted small">Welcome back, <span class="highlight">continue your journey</span> with WanderLust.</p>
                </div>

                <form action="/login" method="POST" class="auth-form needs-validation" novalidate>
                    <div class="mb-3">
                        <label for="username" class="form-label small font-semibold">Username</label>
                        <input type="text" name="username" id="username" class="form-control" placeholder="Enter your username" required />
                        <div class="invalid-feedback">Please enter your username.</div>
                    </div>
                    <div class="mb-4">
                        <label for="password" class="form-label small font-semibold">Password</label>
                        <input type="password" name="password" id="password" class="form-control" placeholder="Enter your password" required />
                        <div class="invalid-feedback">Please enter your password.</div>
                    </div>

                    <button class="btn-solid-asym w-100 justify-content-center" type="submit">
                        Log in <i class="fa-solid fa-arrow-up-right-from-square ms-1" style="font-size: 0.75rem;" aria-hidden="true"></i>
                    </button>

                    <div class="mt-4 text-center">
                        <p class="text-muted small mb-0">Don't have an account? <a href="/signup" class="text-decoration-none" style="color: var(--foreground); font-weight: 500;">Sign up here</a></p>
                    </div>
                </form>
            </div>
        </div>
    </div>