<% layout('/layouts/boilerplate') %>

<style>
  /* ===================================================================
     New Listing Form - Modern ChaiUI Styling
     =================================================================== */

  .form-shell {
    padding: 2.5rem 0 4rem;
  }

  .form-card-chai {
    background: rgba(18, 18, 18, 0.65);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--card-edge);
    border-radius: 1rem;
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    box-shadow: none;
  }

  :root:not(.dark) .form-card-chai {
    background: #ffffff;
    border-color: rgba(120, 53, 15, 0.15);
  }

  .form-title-head {
    font-family: var(--font-sans) !important;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--foreground);
    margin-bottom: 0.5rem;
  }

  .form-subtitle-head {
    font-size: 0.9375rem;
    color: var(--muted-foreground);
    margin-bottom: 2rem;
  }

  /* File Upload Zone */
  .upload-dropzone {
    border: 2px dashed var(--border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-align: center;
    background: rgba(255, 255, 255, 0.02);
    cursor: pointer;
    transition: border-color 150ms ease, background-color 150ms ease;
  }

  .upload-dropzone:hover {
    border-color: var(--card-edge-hover);
    background: rgba(255, 255, 255, 0.04);
  }

  .listing-preview-frame {
    display: none;
    margin-top: 1rem;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 1px solid var(--card-edge);
    max-height: 280px;
  }

  .listing-preview-frame img {
    width: 100%;
    height: 280px;
    object-fit: cover;
    display: block;
  }
</style>

<div class="chai-container form-shell">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <!-- Back Link -->
      <a href="/listings" class="show-nav-back mb-3 d-inline-flex" style="text-decoration: none; color: var(--muted-foreground); font-size: 0.875rem;">
        <i class="fa-solid fa-arrow-left me-2"></i>Back to listings
      </a>

      <div class="form-card-chai">
        <div class="text-center mb-4">
          <div class="chai-animated-badge mb-2">
            <span class="chai-animated-badge-text">
              <i class="fa-solid fa-plus-circle me-1" style="color: var(--brand);"></i> Host Community
            </span>
          </div>
          <h1 class="form-title-head">Host a New Destination</h1>
          <p class="form-subtitle-head">Share your unique property or travel experience with travelers worldwide.</p>
        </div>

        <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
          <!-- Title -->
          <div class="mb-3">
            <label for="title" class="form-label">Destination Title</label>
            <input type="text" placeholder="e.g., Clifftop Villa with Ocean Sunset" name="listing[title]" id="title" class="form-control" required />
            <div class="valid-feedback">Title looks great!</div>
            <div class="invalid-feedback">Please enter a catchy title.</div>
          </div>

          <!-- Description -->
          <div class="mb-3">
            <label for="description" class="form-label">Description</label>
            <textarea name="listing[description]" id="description" class="form-control" rows="3" placeholder="Describe the ambiance, surrounding nature, and amenities..." required></textarea>
            <div class="valid-feedback">Looks good!</div>
            <div class="invalid-feedback">Please provide a description.</div>
          </div>

          <!-- Category -->
          <div class="mb-3">
            <label for="category" class="form-label">Category</label>
            <select name="listing[category]" id="category" class="form-select" required>
              <option selected disabled value="">Choose category</option>
              <option>Trending</option>
              <option>Rooms</option>
              <option>Iconic Cities</option>
              <option>Mountains</option>
              <option>Castles</option>
              <option>Amazing Pool</option>
              <option>Camping</option>
              <option>Farms</option>
              <option>Arctic</option>
              <option>Domes</option>
              <option>Boats</option>
            </select>
            <div class="valid-feedback">Category selected!</div>
            <div class="invalid-feedback">Please select a category.</div>
          </div>

          <!-- Best Season & Travel Tip -->
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label for="bestSeason" class="form-label">Best Season to Visit</label>
              <input name="listing[bestSeason]" id="bestSeason" placeholder="e.g., Autumn (Sep - Nov)" type="text" class="form-control">
            </div>
            <div class="col-md-6">
              <label for="travelTip" class="form-label">Travel Buddy Tip</label>
              <input name="listing[travelTip]" id="travelTip" placeholder="e.g., Book sunset cruise early" type="text" class="form-control">
            </div>
          </div>

          <!-- Image Upload -->
          <div class="mb-3">
            <label for="image" class="form-label">Listing Cover Photo</label>
            <div class="upload-dropzone" onclick="document.getElementById('image').click();">
              <i class="fa-solid fa-cloud-arrow-up fa-2x mb-2" style="color: var(--brand);"></i>
              <div style="font-weight: 600; color: var(--foreground); font-size: 0.95rem;">Click to upload image</div>
              <div style="font-size: 0.8125rem; color: var(--muted-foreground);">High-resolution JPG, PNG, or WebP recommended</div>
              <input type="file" name="listing[image]" id="image" class="d-none" accept="image/*" onchange="previewImage(event)" required>
            </div>
            <div class="listing-preview-frame">
              <img id="imagePreview" src="" alt="Preview">
            </div>
            <div class="invalid-feedback">Please upload an image.</div>
          </div>

          <!-- Price & Country -->
          <div class="row g-3 mb-3">
            <div class="col-md-4">
              <label for="price" class="form-label">Price per night (₹)</label>
              <input placeholder="2500" name="listing[price]" id="price" class="form-control" type="number" required />
              <div class="invalid-feedback">Please enter a valid price.</div>
            </div>
            <div class="col-md-8">
              <label for="country" class="form-label">Country</label>
              <input type="text" placeholder="e.g., India" name="listing[country]" id="country" class="form-control" required />
              <div class="invalid-feedback">Please enter the country.</div>
            </div>
          </div>

          <!-- Location -->
          <div class="mb-4">
            <label for="location" class="form-label">City / Region</label>
            <input type="text" placeholder="e.g., Jaipur, Rajasthan" name="listing[location]" id="location" class="form-control" required />
            <div class="invalid-feedback">Please enter the location.</div>
          </div>

          <!-- Submit CTA -->
          <button type="submit" class="btn-solid-asym w-100 justify-content-center py-3" style="font-size: 1rem;">
            <i class="fa-solid fa-plus me-2"></i>Publish listing
          </button>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
  function previewImage(event) {
    const input = event.target;
    const frame = document.querySelector('.listing-preview-frame');
    const preview = document.getElementById('imagePreview');

    if (input.files && input.files[0]) {
      const reader = new FileReader();
      reader.onload = function(e) {
        preview.src = e.target.result;
        frame.style.display = 'block';
      }
      reader.readAsDataURL(input.files[0]);
    } else {
      preview.src = "";
      frame.style.display = 'none';
    }
  }

  (() => {
    'use strict';
    const forms = document.querySelectorAll('.needs-validation');
    Array.from(forms).forEach(form => {
      form.addEventListener('submit', event => {
        if (!form.checkValidity()) {
          event.preventDefault();
          event.stopPropagation();
        }
        form.classList.add('was-validated');
      }, false);
    });
  })();
</script>
