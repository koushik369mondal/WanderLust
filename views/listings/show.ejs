<% layout('/layouts/boilerplate') %>

<script>
  const mapToken = "<%= process.env.MAP_TOKEN %>";
  const listing = <%- JSON.stringify(listing) %>;

  if (typeof mapboxgl === 'undefined') {
    console.error('Mapbox GL library not loaded');
  }

  if (!listing.geometry || !listing.geometry.coordinates) {
    listing.geometry = { type: "Point", coordinates: null };
  }
</script>

<style>
  /* ===================================================================
     Show Page - Modern ChaiUI Styling
     =================================================================== */

  .show-container {
    padding-top: 1.5rem;
    padding-bottom: 4rem;
  }

  /* Breadcrumb & Navigation */
  .show-nav-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    margin-bottom: 1.25rem;
    transition: color 150ms ease;
  }

  .show-nav-back:hover {
    color: var(--brand);
  }

  /* Header Section */
  .show-header-row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .show-title {
    font-family: var(--font-sans) !important;
    font-size: clamp(1.75rem, 3.5vw, 2.5rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--foreground);
    margin-bottom: 0.35rem;
  }

  .show-location-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .show-location-meta i {
    color: var(--brand);
  }

  .show-badges {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .show-badge {
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.65rem;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
    color: var(--foreground);
    text-decoration: none;
  }

  /* Image Showcase */
  .show-media-frame {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    border: 1px solid var(--card-edge);
    background: #141414;
    aspect-ratio: 16/9;
    max-height: 520px;
    width: 100%;
    margin-bottom: 2.5rem;
  }

  .show-media-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Surface Cards */
  .show-card-surface {
    background: rgba(18, 18, 18, 0.6);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid var(--card-edge);
    border-radius: 0.875rem;
    padding: 1.75rem;
    margin-bottom: 1.75rem;
  }

  :root:not(.dark) .show-card-surface {
    background: #ffffff;
    border-color: rgba(120, 53, 15, 0.15);
  }

  .show-section-heading {
    font-family: var(--font-sans);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--foreground);
    margin-bottom: 1rem;
    display: flex;
    align-items: center;
    gap: 0.65rem;
  }

  .show-section-heading i {
    color: var(--brand);
    font-size: 1.1rem;
  }

  /* Host Profile Bar */
  .host-bar {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.5rem;
  }

  .host-avatar {
    width: 52px;
    height: 52px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--card-edge);
    color: var(--foreground);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    font-weight: 700;
  }

  :root:not(.dark) .host-avatar {
    background: rgba(0, 0, 0, 0.05);
    border-color: rgba(0, 0, 0, 0.1);
  }

  .host-name {
    font-weight: 600;
    color: var(--foreground);
    font-size: 1.05rem;
    margin-bottom: 0.15rem;
  }

  .host-subtitle {
    font-size: 0.8125rem;
    color: var(--muted-foreground);
  }

  /* Property Highlights 3-Grid */
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .highlight-pill-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    padding: 1rem;
  }

  :root:not(.dark) .highlight-pill-card {
    background: rgba(0, 0, 0, 0.02);
  }

  .highlight-pill-label {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--muted-foreground);
    margin-bottom: 0.25rem;
  }

  .highlight-pill-val {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--foreground);
  }

  /* Sticky Booking Widget */
  .sticky-booking-card {
    position: sticky;
    top: 84px;
    background: rgba(18, 18, 18, 0.75);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid var(--card-edge);
    border-radius: 1rem;
    padding: 1.75rem;
    box-shadow: none;
  }

  :root:not(.dark) .sticky-booking-card {
    background: #ffffff;
    border-color: rgba(120, 53, 15, 0.2);
  }

  .booking-price-row {
    display: flex;
    align-items: baseline;
    gap: 0.35rem;
    margin-bottom: 1.25rem;
  }

  .booking-price-number {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 700;
    color: var(--foreground);
  }

  .booking-price-unit {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .booking-calculator {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 0.625rem;
    padding: 1rem;
    margin: 1.25rem 0;
  }

  .calc-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.875rem;
    color: var(--muted-foreground);
    margin-bottom: 0.4rem;
  }

  .calc-total {
    border-top: 1px solid var(--border);
    padding-top: 0.6rem;
    margin-top: 0.6rem;
    font-weight: 700;
    color: var(--foreground);
    font-size: 1rem;
  }

  /* AI Insights Card */
  .ai-insights-surface {
    background: rgba(20, 20, 20, 0.7);
    border: 1px solid var(--card-edge);
    border-left: 3px solid var(--brand);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.75rem;
  }

  /* Weather Overview */
  .weather-summary-box {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .weather-temp-hero {
    font-family: var(--font-display);
    font-size: 2.75rem;
    font-weight: 700;
    color: var(--foreground);
    line-height: 1;
  }

  /* Review Grid */
  .reviews-container-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .show-review-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
  }

  :root:not(.dark) .show-review-card {
    background: rgba(0, 0, 0, 0.02);
  }

  /* Map Container */
  #map {
    height: 380px;
    width: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
  }
</style>

<div class="chai-container show-container">
  <!-- Back Button -->
  <a href="/listings" class="show-nav-back">
    <i class="fa-solid fa-arrow-left"></i> Back to all destinations
  </a>

  <!-- Header Section -->
  <div class="show-header-row">
    <div>
      <h1 class="show-title"><%= listing.title %></h1>
      <div class="show-location-meta">
        <span><i class="fa-solid fa-location-dot"></i> <%= listing.location %>, <%= listing.country %></span>
        <span>•</span>
        <span><i class="fa-solid fa-heart" style="color: #ef4444;"></i> <%= listing.likes ? listing.likes.length : 0 %> <%= __('likes') %></span>
        <% if (listing.category) { %>
          <span>•</span>
          <span class="show-badge"><%= listing.category %></span>
        <% } %>
      </div>
    </div>

    <!-- Badges & Actions -->
    <div class="d-flex align-items-center gap-2 flex-wrap">
      <% if (listing.isNewBadge) { %>
        <span class="show-badge" style="border-color: rgba(34, 197, 94, 0.6); color: #4ade80;">New</span>
      <% } %>
      <% if (listing.isFeaturedBadge) { %>
        <span class="show-badge" style="border-color: rgba(59, 130, 246, 0.6); color: #60a5fa;">Featured</span>
      <% } %>
      <% if (listing.isHighlyRatedBadge) { %>
        <span class="show-badge" style="border-color: rgba(234, 179, 8, 0.6); color: #facc15;">Highly Rated</span>
      <% } %>

      <% if (currentUser) { %>
        <% if (listing.likes && listing.likes.some(id => id.toString() === currentUser._id.toString())) { %>
          <form action="/listings/<%= listing._id %>/unlike" method="POST" style="display: inline;">
            <button type="submit" class="btn-card-action" style="background: rgba(239, 68, 68, 0.2); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.4);">
              <i class="fa-solid fa-heart-crack me-1"></i> Liked
            </button>
          </form>
        <% } else { %>
          <form action="/listings/<%= listing._id %>/like" method="POST" style="display: inline;">
            <button type="submit" class="btn-card-action">
              <i class="fa-regular fa-heart me-1"></i> Like
            </button>
          </form>
        <% } %>

        <% if (isInWishlist) { %>
          <form action="/profile/wishlist/<%= listing._id %>?_method=DELETE&redirect=listing" method="POST" style="display: inline;">
            <button type="submit" class="btn-card-action" style="background: rgba(234, 179, 8, 0.2); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.4);">
              <i class="fa-solid fa-bookmark me-1"></i> Saved
            </button>
          </form>
        <% } else { %>
          <a href="/profile/wishlist/add/<%= listing._id %>" class="btn-card-action">
            <i class="fa-regular fa-bookmark me-1"></i> Save
          </a>
        <% } %>
      <% } %>
    </div>
  </div>

  <!-- Showcase Media Frame -->
  <div class="show-media-frame">
    <img src="<%= listing.image?.url ? listing.image.url.replace('/upload/', '/upload/f_auto,q_auto,w_1400/') : 'https://via.placeholder.com/1200x700' %>"
      class="show-media-img" alt="<%= listing.title %>" fetchpriority="high">
  </div>

  <!-- 2-Column Content Grid -->
  <div class="row g-4">
    <!-- Left Column (Overview, Details, AI, Weather, Map, Reviews) -->
    <div class="col-lg-8">
      <!-- Host & Highlights -->
      <div class="show-card-surface">
        <div class="host-bar">
          <div class="host-avatar">
            <%= (listing.owner && listing.owner.username) ? listing.owner.username.charAt(0).toUpperCase() : 'H' %>
          </div>
          <div>
            <div class="host-name">Hosted by <%= (listing.owner && listing.owner.username) ? listing.owner.username : 'WanderLust Verified Host' %></div>
            <div class="host-subtitle">Local experience partner • Verified property</div>
          </div>
        </div>

        <div class="highlights-grid">
          <div class="highlight-pill-card">
            <div class="highlight-pill-label">Category</div>
            <div class="highlight-pill-val"><%= listing.category || 'Handcrafted Stay' %></div>
          </div>
          <div class="highlight-pill-card">
            <div class="highlight-pill-label">Best Season</div>
            <div class="highlight-pill-val"><%= listing.bestSeason || 'Year-round' %></div>
          </div>
          <div class="highlight-pill-card">
            <div class="highlight-pill-label">Local tip</div>
            <div class="highlight-pill-val"><%= listing.travelTip ? `"${listing.travelTip}"` : 'Pack light & explore' %></div>
          </div>
        </div>

        <h3 class="show-section-heading">
          <i class="fa-solid fa-align-left"></i> About this destination
        </h3>
        <p style="color: var(--foreground); line-height: 1.75; font-size: 1rem; margin-bottom: 0;">
          <%= listing.description || 'Welcome to this handcrafted getaway. Experience the unique sights, culture, and hospitality of this destination.' %>
        </p>
      </div>

      <!-- AI Insights Card (if generated) -->
      <% if (listing.aiSummary) { %>
        <div class="ai-insights-surface">
          <div class="d-flex align-items-center gap-2 mb-2">
            <div class="chai-animated-badge">
              <span class="chai-animated-badge-text">
                <i class="fa-solid fa-sparkles me-1" style="color: var(--brand);"></i> AI Insights
              </span>
            </div>
            <span style="font-size: 0.8125rem; color: var(--muted-foreground);">Summarized from traveler reviews</span>
          </div>
          <p style="color: var(--foreground); font-size: 0.95rem; line-height: 1.6; margin: 0;">
            <%= listing.aiSummary %>
          </p>
        </div>
      <% } %>

      <!-- Live Destination Weather (if coordinates available) -->
      <% if (typeof weatherData !== 'undefined' && weatherData) { %>
        <div class="show-card-surface">
          <h3 class="show-section-heading">
            <i class="fa-solid fa-cloud-sun"></i> Live destination weather
          </h3>
          <div class="weather-summary-box">
            <div class="d-flex align-items-center gap-3">
              <span style="font-size: 3rem;">
                <%= weatherData.icon ? (weatherData.icon.includes('d') ? '☀️' : '🌙') : '🌤️' %>
              </span>
              <div>
                <div class="weather-temp-hero"><%= weatherData.temperature %>°C</div>
                <div style="color: var(--muted-foreground); text-transform: capitalize; font-size: 0.9rem;"><%= weatherData.description %></div>
              </div>
            </div>

            <div class="d-flex gap-4 flex-wrap ms-auto">
              <div>
                <div style="font-size: 0.75rem; color: var(--muted-foreground);">FEELS LIKE</div>
                <div style="font-weight: 600; color: var(--foreground);"><%= weatherData.feelsLike %>°C</div>
              </div>
              <div>
                <div style="font-size: 0.75rem; color: var(--muted-foreground);">HUMIDITY</div>
                <div style="font-weight: 600; color: var(--foreground);"><%= weatherData.humidity %>%</div>
              </div>
              <div>
                <div style="font-size: 0.75rem; color: var(--muted-foreground);">WIND</div>
                <div style="font-weight: 600; color: var(--foreground);"><%= weatherData.windSpeed %> m/s</div>
              </div>
              <% if (typeof bestTimeToVisit !== 'undefined' && bestTimeToVisit) { %>
                <div>
                  <div style="font-size: 0.75rem; color: var(--muted-foreground);">BEST TIME</div>
                  <div style="font-weight: 600; color: var(--brand);"><%= bestTimeToVisit %></div>
                </div>
              <% } %>
            </div>
          </div>
        </div>
      <% } %>

      <!-- Where you'll be (Mapbox Map) -->
      <div class="show-card-surface">
        <h3 class="show-section-heading">
          <i class="fa-solid fa-map-location-dot"></i> Where you will be
        </h3>
        <p style="color: var(--muted-foreground); font-size: 0.9rem; margin-bottom: 1rem;">
          <%= listing.location %>, <%= listing.country %>
        </p>
        <div id="map"></div>
      </div>

      <!-- Reviews Section -->
      <div class="show-card-surface">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
          <h3 class="show-section-heading mb-0">
            <i class="fa-solid fa-comments"></i> Traveler stories (<%= listing.reviews ? listing.reviews.length : 0 %>)
          </h3>
          <% if (listing.reviews && listing.reviews.length > 0) { %>
            <% let totalRating = listing.reviews.reduce((sum, review) => sum + review.rating, 0); %>
            <% let avgRating = (totalRating / listing.reviews.length).toFixed(1); %>
            <div class="d-flex align-items-center gap-2">
              <span style="font-family: var(--font-display); font-size: 1.25rem; font-weight: 700; color: var(--foreground);"><%= avgRating %></span>
              <div style="color: #facc15; font-size: 0.875rem;">
                <% for (let i = 1; i <= 5; i++) { %>
                  <i class="fa-solid fa-star <%= i <= Math.round(avgRating) ? '' : 'text-muted' %>"></i>
                <% } %>
              </div>
            </div>
          <% } %>
        </div>

        <!-- Add Review Form (If user logged in) -->
        <% if (currentUser) { %>
          <div style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border); border-radius: 0.75rem; padding: 1.25rem; margin-bottom: 2rem;">
            <h5 style="font-size: 1rem; font-weight: 600; color: var(--foreground); margin-bottom: 1rem;">
              <i class="fa-solid fa-pen-nib me-1" style="color: var(--brand);"></i> Leave a review
            </h5>
            <form action="/listings/<%= listing._id %>/reviews" method="POST" class="review-form needs-validation" novalidate>
              <div class="mb-3">
                <label class="form-label">Rating</label>
                <div class="d-flex align-items-center gap-3">
                  <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Poor">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Fair">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Good">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Excellent">5 stars</label>
                  </fieldset>
                  <span id="rating-text" style="font-size: 0.85rem; color: var(--muted-foreground);">Select a rating</span>
                </div>
              </div>

              <div class="mb-3">
                <label for="comment" class="form-label">Your experience</label>
                <textarea name="review[comment]" id="comment" class="form-control" rows="3" placeholder="Share what made this stay special..." required></textarea>
                <div class="d-flex justify-content-between mt-1">
                  <span style="font-size: 0.75rem; color: var(--muted-foreground);"><span id="char-count">0</span>/500 characters</span>
                  <div class="invalid-feedback" style="display: none;">Please provide at least 10 characters.</div>
                </div>
              </div>

              <button type="submit" class="btn-solid-asym">
                <i class="fa-solid fa-paper-plane me-2"></i>Post review
              </button>
            </form>
          </div>
        <% } %>

        <!-- Review Cards Grid -->
        <% if (listing.reviews && listing.reviews.length > 0) { %>
          <div class="reviews-container-grid">
            <% for (let review of listing.reviews) { %>
              <% if (review && review.author) { %>
                <div class="show-review-card">
                  <div>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                      <div class="d-flex align-items-center gap-2">
                        <div style="width: 32px; height: 32px; border-radius: 9999px; background: rgba(255, 255, 255, 0.08); display: flex; align-items: center; justify-content: center; font-size: 0.85rem; font-weight: 700;">
                          <%= review.author.username ? review.author.username.charAt(0).toUpperCase() : 'U' %>
                        </div>
                        <div>
                          <div style="font-weight: 600; font-size: 0.875rem; color: var(--foreground);">@<%= review.author.username %></div>
                          <div style="font-size: 0.75rem; color: var(--muted-foreground);">
                            <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) : 'Recently' %>
                          </div>
                        </div>
                      </div>

                      <div style="color: #facc15; font-size: 0.75rem;">
                        <% for (let i = 1; i <= 5; i++) { %>
                          <i class="fa-solid fa-star <%= i <= review.rating ? '' : 'text-muted' %>"></i>
                        <% } %>
                      </div>
                    </div>

                    <p style="font-size: 0.9rem; color: var(--foreground); line-height: 1.6; margin-bottom: 0.5rem;" id="review-text-<%= review._id %>">
                      <%= review.comment %>
                    </p>
                  </div>

                  <div class="d-flex justify-content-between align-items-center pt-2" style="border-top: 1px solid var(--border);">
                    <button class="translate-btn btn btn-sm btn-link p-0" style="color: var(--muted-foreground); font-size: 0.75rem; text-decoration: none;"
                      data-review-id="<%= review._id %>" data-listing-id="<%= listing._id %>">
                      <i class="fa-solid fa-language me-1"></i> <span class="translate-text">Translate</span>
                    </button>

                    <% if (currentUser && review.author._id.equals(currentUser._id)) { %>
                      <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" style="display: inline;"
                        onsubmit="return confirm('Delete this review?');">
                        <button type="submit" class="btn btn-sm btn-link p-0 text-danger" style="font-size: 0.75rem; text-decoration: none;">
                          <i class="fa-solid fa-trash me-1"></i> Delete
                        </button>
                      </form>
                    <% } %>
                  </div>
                </div>
              <% } %>
            <% } %>
          </div>
        <% } else { %>
          <div class="text-center py-4" style="color: var(--muted-foreground);">
            <i class="fa-solid fa-comments fa-2x mb-2" style="opacity: 0.5;"></i>
            <p>No reviews yet for this destination. Be the first traveler to share your story!</p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- Right Column (Sticky Reservation & Action Widget) -->
    <div class="col-lg-4">
      <div class="sticky-booking-card">
        <div class="booking-price-row">
          <span class="booking-price-number">₹<%= listing.price ? listing.price.toLocaleString('en-IN') : 'N/A' %></span>
          <span class="booking-price-unit">/ night</span>
        </div>

        <!-- Dates Mockup Selector -->
        <div style="background: rgba(255, 255, 255, 0.04); border: 1px solid var(--border); border-radius: 0.625rem; overflow: hidden; margin-bottom: 1rem;">
          <div class="row g-0">
            <div class="col-6 p-2" style="border-right: 1px solid var(--border);">
              <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: var(--muted-foreground);">Check-in</div>
              <div style="font-size: 0.85rem; font-weight: 500; color: var(--foreground);">Select date</div>
            </div>
            <div class="col-6 p-2">
              <div style="font-size: 0.7rem; font-weight: 600; text-transform: uppercase; color: var(--muted-foreground);">Checkout</div>
              <div style="font-size: 0.85rem; font-weight: 500; color: var(--foreground);">Select date</div>
            </div>
          </div>
        </div>

        <!-- Pricing Calculator Breakdown -->
        <div class="booking-calculator">
          <div class="calc-row">
            <span>₹<%= listing.price ? listing.price.toLocaleString('en-IN') : 0 %> × 3 nights</span>
            <span>₹<%= listing.price ? (listing.price * 3).toLocaleString('en-IN') : 0 %></span>
          </div>
          <div class="calc-row">
            <span>Taxes & GST (+18%)</span>
            <span>₹<%= listing.price ? Math.round(listing.price * 3 * 0.18).toLocaleString('en-IN') : 0 %></span>
          </div>
          <div class="calc-row">
            <span>WanderLust booking fee</span>
            <span style="color: #4ade80;">Free</span>
          </div>
          <div class="calc-row calc-total">
            <span>Total before stay</span>
            <span>₹<%= listing.price ? Math.round(listing.price * 3 * 1.18).toLocaleString('en-IN') : 0 %></span>
          </div>
        </div>

        <!-- Reserve CTA Button -->
        <button type="button" class="btn-solid-asym w-100 justify-content-center mb-2" onclick="alert('Reservation request initiated for <%= listing.title %>! Host will be notified.');">
          <i class="fa-solid fa-calendar-check me-2"></i>Reserve stay
        </button>

        <p class="text-center mb-3" style="font-size: 0.78rem; color: var(--muted-foreground);">You will not be charged yet</p>

        <!-- Owner Actions (if owner) -->
        <% if (currentUser && listing.owner && listing.owner._id && listing.owner._id.equals(currentUser._id)) { %>
          <div class="pt-3 mt-3" style="border-top: 1px solid var(--border);">
            <div style="font-size: 0.75rem; font-weight: 600; text-transform: uppercase; color: var(--muted-foreground); margin-bottom: 0.75rem;">
              Host management
            </div>
            <div class="d-flex gap-2">
              <a href="/listings/<%= listing._id %>/edit" class="btn-card-action flex-fill justify-content-center">
                <i class="fa-solid fa-pen-to-square me-1"></i> Edit listing
              </a>
              <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" style="display: inline;" class="flex-fill"
                onsubmit="return confirm('Are you sure you want to permanently delete this listing?');">
                <button type="submit" class="btn-card-action flex-fill w-100 justify-content-center text-danger">
                  <i class="fa-solid fa-trash me-1"></i> Delete
                </button>
              </form>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Recommendations Section -->
  <% if (typeof recommendations !== 'undefined' && recommendations && recommendations.length > 0) { %>
    <div class="mt-5 pt-4" style="border-top: 1px solid var(--border);">
      <h2 style="font-family: var(--font-sans); font-size: 1.5rem; font-weight: 600; color: var(--foreground); margin-bottom: 1.5rem;">
        <i class="fa-solid fa-sparkles me-2" style="color: var(--brand);"></i> You may also like
      </h2>
      <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
        <% recommendations.slice(0, 4).forEach(rec => { %>
          <div class="col">
            <a href="/listings/<%= rec._id %>" style="text-decoration: none; color: inherit;">
              <div class="card listing-card h-100">
                <div class="listing-image-container" style="aspect-ratio: 16/10; overflow: hidden;">
                  <img src="<%= rec.image?.url ? rec.image.url.replace('/upload/', '/upload/f_auto,q_auto,w_500/') : 'https://via.placeholder.com/300' %>"
                    class="listing-image" alt="<%= rec.title %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover;">
                </div>
                <div class="card-body p-3 d-flex flex-column">
                  <h3 class="listing-title mb-1"><%= rec.title %></h3>
                  <small class="text-muted listing-location mb-3 d-block">
                    <i class="fas fa-map-marker-alt me-1" style="color: var(--brand);"></i> <%= rec.location %>, <%= rec.country %>
                  </small>
                  <div class="d-flex justify-content-between align-items-center mt-auto pt-2">
                    <div>
                      <span class="listing-price">₹<%= rec.price ? rec.price.toLocaleString('en-IN') : 'N/A' %></span>
                      <span class="tax-info">&nbsp;/ night</span>
                    </div>
                    <span class="btn-card-action">View</span>
                  </div>
                </div>
              </div>
            </a>
          </div>
        <% }); %>
      </div>
    </div>
  <% } %>
</div>

<script src="/JS/map.js?v=<%= Date.now() %>"></script>

<script>
  // Review Character Counter & Rating Text
  document.addEventListener('DOMContentLoaded', function () {
    const ratingInputs = document.querySelectorAll('input[name="review[rating]"]');
    const ratingText = document.getElementById('rating-text');
    const ratingLabels = { 1: 'Poor', 2: 'Below expectations', 3: 'Good experience', 4: 'Amazing experience', 5: 'Absolutely perfect' };

    ratingInputs.forEach(input => {
      input.addEventListener('change', function () {
        if (this.value && ratingText) {
          ratingText.textContent = ratingLabels[this.value];
          ratingText.style.color = 'var(--brand)';
          ratingText.style.fontWeight = '600';
        }
      });
    });

    const commentEl = document.getElementById('comment');
    const charCount = document.getElementById('char-count');
    if (commentEl && charCount) {
      commentEl.addEventListener('input', function () {
        charCount.textContent = this.value.length;
      });
    }

    // Translation toggle
    const translateBtns = document.querySelectorAll('.translate-btn');
    translateBtns.forEach(btn => {
      btn.addEventListener('click', async function () {
        const reviewId = this.dataset.reviewId;
        const listingId = this.dataset.listingId;
        const reviewTextEl = document.getElementById(`review-text-${reviewId}`);
        const translateTextEl = this.querySelector('.translate-text');

        if (this.dataset.translated === 'true') {
          reviewTextEl.textContent = this.dataset.originalText;
          translateTextEl.textContent = 'Translate';
          this.dataset.translated = 'false';
          return;
        }

        if (!this.dataset.originalText) {
          this.dataset.originalText = reviewTextEl.textContent;
        }

        translateTextEl.textContent = 'Translating...';
        this.disabled = true;

        try {
          const res = await fetch(`/listings/${listingId}/reviews/translate/${reviewId}`);
          const data = await res.json();
          if (data.translatedText) {
            reviewTextEl.textContent = data.translatedText;
            translateTextEl.textContent = 'Original';
            this.dataset.translated = 'true';
          }
        } catch (e) {
          console.error(e);
        } finally {
          this.disabled = false;
        }
      });
    });
  });
</script>