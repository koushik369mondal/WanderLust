<!-- Premium Category Bar - ChaiUI Standardized -->
<div class="wander-category-bar">
    <div class="category-bar-container">
        <!-- Left Navigation Arrow (shown only when scrolled right) -->
        <button class="category-nav-arrow left is-hidden" aria-label="Scroll categories left" id="scrollLeft" type="button">
            <i class="fa-solid fa-chevron-left" aria-hidden="true"></i>
        </button>

        <!-- Category Pills - Horizontally Scrollable -->
        <div class="category-scroll-wrapper" id="categoryScroll" role="tablist" aria-label="Filter by category">
            <% const categories=[ 
                {name: 'Trending', icon: 'fa-fire' },
                {name: 'Rooms', icon: 'fa-bed' }, 
                {name: 'Iconic Cities', icon: 'fa-mountain-city' }, 
                {name: 'Mountains', icon: 'fa-mountain' }, 
                {name: 'Castles', icon: 'fa-chess-rook' }, 
                {name: 'Amazing pool', icon: 'fa-person-swimming' }, 
                {name: 'Camping', icon: 'fa-tents' }, 
                {name: 'Farms', icon: 'fa-tractor' }, 
                {name: 'Arctic', icon: 'fa-snowflake' }, 
                {name: 'Domes', icon: 'fa-igloo' }, 
                {name: 'Boats', icon: 'fa-ship' } 
            ]; %>

            <% categories.forEach(cat => { %>
                <a href="/listings?category=<%= encodeURIComponent(cat.name) %>" class="category-item" role="tab"
                    aria-selected="<%= (typeof category !== 'undefined' && category === cat.name) ? 'true' : 'false' %>">
                    <div class="category-pill <%= (typeof category !== 'undefined' && category === cat.name) ? 'active' : '' %>">
                        <i class="fa-solid <%= cat.icon %>" aria-hidden="true"></i>
                        <span><%= cat.name %></span>
                    </div>
                </a>
            <% }); %>
        </div>

        <!-- Right Navigation Arrow (shown only when overflowing) -->
        <button class="category-nav-arrow right is-hidden" aria-label="Scroll categories right" id="scrollRight" type="button">
            <i class="fa-solid fa-chevron-right" aria-hidden="true"></i>
        </button>
    </div>
</div>

<script>
// Category scroll navigation - Smart directional controls
(function() {
    const scrollContainer = document.getElementById('categoryScroll');
    const scrollLeftBtn = document.getElementById('scrollLeft');
    const scrollRightBtn = document.getElementById('scrollRight');
    
    if (!scrollContainer || !scrollLeftBtn || !scrollRightBtn) return;
    
    const scrollStep = 320;
    
    scrollLeftBtn.addEventListener('click', (e) => {
        e.preventDefault();
        scrollContainer.scrollBy({ left: -scrollStep, behavior: 'smooth' });
    });
    
    scrollRightBtn.addEventListener('click', (e) => {
        e.preventDefault();
        scrollContainer.scrollBy({ left: scrollStep, behavior: 'smooth' });
    });
    
    // Update arrow visibility: arrows only display when horizontal overflow exists in that direction
    function updateArrows() {
        const scrollLeft = scrollContainer.scrollLeft;
        const scrollWidth = scrollContainer.scrollWidth;
        const clientWidth = scrollContainer.clientWidth;
        const canScroll = scrollWidth > clientWidth + 4;
        
        if (!canScroll) {
            scrollLeftBtn.classList.add('is-hidden');
            scrollRightBtn.classList.add('is-hidden');
            return;
        }
        
        // Left arrow only appears when scrolled past initial position
        if (scrollLeft > 12) {
            scrollLeftBtn.classList.remove('is-hidden');
        } else {
            scrollLeftBtn.classList.add('is-hidden');
        }
        
        // Right arrow appears when more content is available to the right
        if (scrollLeft + clientWidth < scrollWidth - 12) {
            scrollRightBtn.classList.remove('is-hidden');
        } else {
            scrollRightBtn.classList.add('is-hidden');
        }
    }
    
    scrollContainer.addEventListener('scroll', updateArrows, { passive: true });
    window.addEventListener('resize', updateArrows);
    
    // Initial checks after layout and font loads
    setTimeout(updateArrows, 60);
    setTimeout(updateArrows, 300);

    // Scroll active item into view if not visible
    const activeItem = scrollContainer.querySelector('.category-pill.active');
    if (activeItem) {
        setTimeout(() => {
            activeItem.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
        }, 150);
    }
})();
</script>
