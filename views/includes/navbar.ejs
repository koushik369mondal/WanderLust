          <span>Search</span>
        </button>
      </div>
    </form>

    <!-- Primary Nav Links -->
    <div>
      <div class="wander-mobile-section-title">Navigation</div>
      <a href="/listings" class="wander-mobile-link">
        <i class="fa-solid fa-earth-americas" aria-hidden="true"></i>
        <span>All listings</span>
      </a>
      <a href="/about" class="wander-mobile-link">
        <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
        <span>About</span>
      </a>
      <a href="/listings/new" class="wander-mobile-link">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>Add new listing</span>
      </a>
    </div>

    <!-- Travel Tools -->
    <div>
      <div class="wander-mobile-section-title">Travel Tools</div>
      <a href="/trip-planner" class="wander-mobile-link">
        <i class="fa-solid fa-route" aria-hidden="true"></i>
        <span>Trip planner</span>
      </a>
      <a href="/packing-list" class="wander-mobile-link">
        <i class="fa-solid fa-suitcase" aria-hidden="true"></i>
        <span>Packing list</span>
      </a>
      <a href="/holiday" class="wander-mobile-link">
        <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
        <span>Holiday calendar</span>
      </a>
      <a href="/listings/compare" class="wander-mobile-link">
        <i class="fa-solid fa-scale-balanced" aria-hidden="true"></i>
        <span>Compare destinations</span>
      </a>
      <a href="/weather" class="wander-mobile-link">
        <i class="fa-solid fa-cloud-sun" aria-hidden="true"></i>
        <span>Weather info</span>
      </a>
      <a href="/trip-planner/mood-fixing" class="wander-mobile-link">
        <i class="fa-solid fa-music" aria-hidden="true"></i>
        <span>Mood fixing</span>
      </a>
      <a href="/achievements" class="wander-mobile-link">
        <i class="fa-solid fa-trophy" aria-hidden="true"></i>
        <span>Achievements</span>
      </a>
      <a href="/leaderboard" class="wander-mobile-link">
        <i class="fa-solid fa-chart-line" aria-hidden="true"></i>
        <span>Leaderboard</span>
      </a>
    </div>

    <!-- Account / Auth -->
    <div>
      <div class="wander-mobile-section-title">Account</div>
      <% if (typeof currentUser === 'undefined' || !currentUser) { %>
        <div class="d-flex flex-column gap-2 mt-2">
          <a href="/login" class="wander-btn-soft justify-content-center w-100">
            <i class="fa-solid fa-arrow-right-to-bracket me-1" aria-hidden="true"></i>
            <span>Log in</span>
          </a>
          <a href="/signup" class="btn-solid-asym justify-content-center w-100" style="height: 36px;">
            <span>Sign up</span>
            <i class="fa-solid fa-arrow-up-right-from-square ms-1" style="font-size: 0.7rem;" aria-hidden="true"></i>
