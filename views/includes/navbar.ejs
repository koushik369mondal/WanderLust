<!-- WanderLust Navbar - ChaiUI Design System -->
<header class="wander-navbar" role="banner">
  <div class="wander-nav-container">
    <!-- LEFT: Brand Logo -->
    <a href="/listings" class="wander-brand" aria-label="WanderLust - Go to home page">
      <img src="/images/logo.svg" alt="WanderLust logo" class="wander-brand-icon" width="28" height="28" />
      <span class="wander-brand-name">WanderLust</span>
    </a>

    <!-- CENTER: Nav Links & Search -->
    <div class="wander-nav-center">
      <div class="wander-nav-links">
        <a href="/listings" class="wander-nav-link">
          <i class="fa-solid fa-earth-americas" aria-hidden="true"></i>
          <span>All listings</span>
        </a>

        <a href="/about" class="wander-nav-link">
          <i class="fa-solid fa-circle-info" aria-hidden="true"></i>
          <span>About</span>
        </a>

        <!-- Travel Tools Dropdown -->
        <div class="dropdown">
          <button class="wander-nav-link" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="travelToolsDropdown">
            <i class="fa-solid fa-toolbox" aria-hidden="true"></i>
            <span>Travel tools</span>
            <i class="fa-solid fa-chevron-down chevron-icon" aria-hidden="true"></i>
          </button>
          <ul class="dropdown-menu wander-dropdown-menu" aria-labelledby="travelToolsDropdown">
            <li><a class="dropdown-item" href="/trip-planner"><i class="fa-solid fa-route"></i>Trip planner</a></li>
            <li><a class="dropdown-item" href="/packing-list"><i class="fa-solid fa-suitcase"></i>Packing list</a></li>
            <li><a class="dropdown-item" href="/holiday"><i class="fa-solid fa-calendar-days"></i>Holiday calendar</a></li>
            <li><a class="dropdown-item" href="/listings/compare"><i class="fa-solid fa-scale-balanced"></i>Compare destinations</a></li>
            <li><a class="dropdown-item" href="/trip-planner/mood-fixing"><i class="fa-solid fa-music"></i>Mood fixing</a></li>
            <li><hr></li>
            <li><a class="dropdown-item" href="/weather"><i class="fa-solid fa-cloud-sun"></i>Weather info</a></li>
            <li><hr></li>
            <li><a class="dropdown-item" href="/achievements"><i class="fa-solid fa-trophy"></i>Achievements</a></li>
            <li><a class="dropdown-item" href="/leaderboard"><i class="fa-solid fa-chart-line"></i>Leaderboard</a></li>
          </ul>
        </div>
      </div>

      <!-- Airbnb-Style Segmented Pill Search Bar -->
      <div class="wander-search-box">
        <form method="GET" action="/listings" role="search" aria-label="Search destinations">
          <div class="wander-search-wrapper" id="wanderSearchWrapper">
            <i class="fa-solid fa-magnifying-glass wander-search-icon" aria-hidden="true"></i>
            <div class="wander-search-input-wrap">
              <input type="text" name="search" id="searchInput" class="wander-search-input"
                placeholder="Where to? Search destinations, stays..."
                value="<%= typeof searchQuery !== 'undefined' && searchQuery ? searchQuery : '' %>"
                autocomplete="off" aria-label="Search destinations" aria-autocomplete="list" aria-controls="searchSuggestions" />
            </div>
            <button type="button" class="wander-search-clear" id="searchClearBtn" aria-label="Clear search" style="<%= (typeof searchQuery !== 'undefined' && searchQuery) ? 'display: inline-flex;' : 'display: none;' %>">
              <i class="fa-solid fa-xmark" aria-hidden="true"></i>
            </button>
            <button type="submit" class="wander-search-btn" aria-label="Search destinations">
              <span>Search</span>
            </button>
          </div>
        </form>
        <div class="search-suggestions" id="searchSuggestions" role="listbox" aria-label="Search suggestions"></div>
      </div>
    </div>

    <!-- RIGHT: Actions, Auth, Lang, Theme -->
    <div class="wander-nav-right">
      <!-- Add New Listing CTA -->
      <a href="/listings/new" class="wander-btn-soft wander-nav-desktop-only">
        <i class="fa-solid fa-plus" aria-hidden="true"></i>
        <span>Add new listing</span>
      </a>

      <% if (typeof currentUser === 'undefined' || !currentUser) { %>
        <!-- Guest: Log in & Sign up -->
        <a href="/login" class="wander-nav-link wander-nav-desktop-only">
          <span>Log in</span>
        </a>
        <a href="/signup" class="btn-solid-asym wander-nav-desktop-only" style="height: 34px; padding: 0 0.875rem; font-size: 0.8125rem;">
          <span>Sign up</span>
          <i class="fa-solid fa-arrow-up-right-from-square ms-1" style="font-size: 0.65rem;" aria-hidden="true"></i>
        </a>
      <% } else { %>
        <!-- Logged-in: Notifications Dropdown -->
        <div class="dropdown wander-nav-desktop-only">
          <button class="wander-icon-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="notificationToggle" aria-label="View notifications">
            <i class="fa-solid fa-bell" aria-hidden="true"></i>
            <span id="notificationBadge" class="wander-badge-dot" style="display: none;">0</span>
          </button>
          <div class="dropdown-menu dropdown-menu-end wander-dropdown-menu wander-notifications-panel" aria-labelledby="notificationToggle">
            <div class="wander-notifications-header">
              <h6>Notifications</h6>
              <button id="markAllRead" type="button" class="btn btn-sm btn-link text-decoration-none p-0" style="font-size: 0.75rem; color: var(--brand);">Mark all read</button>
            </div>
            <div id="notificationList" class="wander-notifications-body">
              <div class="text-center text-muted p-4" id="noNotifications">
                <i class="fa-solid fa-bell-slash mb-2" style="font-size: 1.5rem;" aria-hidden="true"></i>
                <p class="mb-0 small">No notifications yet</p>
              </div>
            </div>
            <div class="p-2 border-top text-center" style="border-color: var(--card-edge) !important;">
              <a href="/notifications" class="small text-decoration-none" style="color: var(--foreground); font-weight: 500;">View all notifications</a>
            </div>
          </div>
        </div>

        <!-- Logged-in: User Profile Dropdown -->
        <div class="dropdown wander-nav-desktop-only">
          <button class="wander-btn-soft" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="profileDropdown" aria-label="User profile menu">
            <i class="fa-solid fa-circle-user" aria-hidden="true"></i>
            <span class="text-truncate" style="max-width: 100px;"><%= (currentUser && currentUser.username) ? currentUser.username : 'Profile' %></span>
            <i class="fa-solid fa-chevron-down chevron-icon" aria-hidden="true"></i>
          </button>
          <ul class="dropdown-menu dropdown-menu-end wander-dropdown-menu" aria-labelledby="profileDropdown">
            <li><a class="dropdown-item" href="/profile"><i class="fa-solid fa-user"></i>My profile</a></li>
            <li><a class="dropdown-item" href="/profile/wishlist"><i class="fa-solid fa-bookmark"></i>My wishlist</a></li>
            <li><a class="dropdown-item" href="/profile/likes"><i class="fa-solid fa-heart"></i>Liked listings</a></li>
            <li><a class="dropdown-item" href="/profile/vacation-slots">
              <i class="fa-solid fa-calendar-check"></i>My vacation slots
              <% if (currentUser && currentUser.vacationSlots && currentUser.vacationSlots.length > 0) { %>
                <span class="badge rounded-pill bg-danger ms-auto" style="font-size: 0.65rem;"><%= currentUser.vacationSlots.length %></span>
              <% } %>
            </a></li>
            <li><a class="dropdown-item" href="/trip-planner/my-trips"><i class="fa-solid fa-suitcase-rolling"></i>My trip plans</a></li>
            <li><a class="dropdown-item" href="/phrase-assistant"><i class="fa-solid fa-language"></i>Phrase assistant</a></li>
            <li><a class="dropdown-item" href="/profile/travel-journal"><i class="fa-solid fa-book"></i>Travel journal</a></li>
            <li><a class="dropdown-item" href="/trip-planner/offline-trips">
              <i class="fa-solid fa-download"></i>My downloads
              <span id="profileDownloadCount" class="badge rounded-pill bg-info ms-auto" style="display: none; font-size: 0.65rem;">0</span>
            </a></li>
            <% if (currentUser && currentUser.isAdmin) { %>
              <li><hr></li>
              <li><a class="dropdown-item" href="/admin/dashboard"><i class="fa-solid fa-chart-line"></i>Admin dashboard</a></li>
            <% } %>
            <li><hr></li>
            <li><a class="dropdown-item text-danger" href="/logout"><i class="fa-solid fa-arrow-right-from-bracket text-danger"></i>Log out</a></li>
          </ul>
        </div>
      <% } %>

      <!-- Theme Switcher -->
      <div class="d-flex align-items-center">
        <%- include("../includes/theme-toggle.ejs") %>
      </div>

      <!-- Mobile Menu Hamburger Button -->
      <button class="wander-icon-btn wander-mobile-toggle" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu" aria-controls="mobileMenu" aria-label="Toggle navigation menu">
        <i class="fa-solid fa-bars" aria-hidden="true"></i>
      </button>
    </div>
  </div>
</header>

